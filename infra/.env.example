# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA EQUIPE MORCEGO
# ==============================================================================

# Django
DJANGO_SECRET_KEY=sua-chave-secreta-complexa-producao-2026
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=equipemorcego.com.br,www.equipemorcego.com.br,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://equipemorcego.com.br,https://www.equipemorcego.com.br
SITE_DOMAIN=equipemorcego.com.br
SITE_URL=https://equipemorcego.com.br
TIME_ZONE=America/Fortaleza

# Banco de Dados PostgreSQL (Produção)
POSTGRES_DB=morcego_trilhas
POSTGRES_USER=morcego
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
DATABASE_URL=postgres://morcego:defina_uma_senha_forte_aqui@db:5432/morcego_trilhas

# Redis / Fila
REDIS_URL=redis://redis:6379/1

# Mercado Pago - criar aplicação na conta PRÓPRIA da Equipe Morcego.
# Sem as credenciais abaixo, pagamentos online permanecem indisponíveis.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_WEBHOOK_URL=https://equipemorcego.nabio.pro/integracoes/mercadopago/webhook/
MP_ENVIRONMENT=sandbox
MP_API_BASE=https://api.mercadopago.com
MP_WEBHOOK_MAX_AGE_SECONDS=900
# Opcional: chave exclusiva estável para proteger credenciais salvas no painel.
# Vazio deriva a chave da DJANGO_SECRET_KEY. Não altere sem recriptografar o banco.
MP_CREDENTIALS_ENCRYPTION_KEY=

# E-mail Transacional SMTP
EMAIL_HOST=smtp.provedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=contato@equipemorcego.com.br
EMAIL_HOST_PASSWORD=sua_senha_smtp
DEFAULT_FROM_EMAIL=contato@equipemorcego.com.br
PUBLIC_SITE_URL=https://equipemorcego.nabio.pro
