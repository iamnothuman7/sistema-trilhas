{$SITE_DOMAIN:equipemorcego.com.br} {
    encode gzip zstd

    # Segurança HTTP Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Arquivos Estáticos Servidos Diretamente com Cache Eficiente
    handle_path /static/* {
        root * /var/www/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    @private_paths path /media/expenses/receipts/* /media/evidences/* /private-media/* /runtime/*
    respond @private_paths 404

    # Only public images are served directly. Financial documents use authorized views.
    handle_path /media/* {
        root * /var/www/media
        file_server
    }

    # Proxy Reverso para a Aplicação Django (Gunicorn)
    handle {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
